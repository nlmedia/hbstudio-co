---
import { useTranslations, getLocaleFromPath, localizePath } from '../i18n';

const year = new Date().getFullYear();
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<!-- The footer sits on the page ground, not on an inverted slab. It used to be
     inverted, which fused it with the inverted final CTA into one long pale
     block and ended a dark site on a light note. One inverted moment per page,
     and it belongs to the call to action. -->
<footer class="border-t border-hair">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center bg-signal font-display text-sm font-bold text-on-signal">HB</span>
        <span class="font-display text-[15px] font-semibold">HB Studio.Co</span>
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-fg-muted">{t.footer.tagline}</p>
    </div>
    <div>
      <h4 class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{t.footer.catalogueHeading}</h4>
      <ul class="mt-4 space-y-2.5 text-sm text-fg-muted">
        <li><a class="transition hover:text-fg" href={localizePath('/templates', locale)}>{t.footer.allTemplates}</a></li>
        <li><a class="transition hover:text-fg" href={localizePath('/category/shopify', locale)}>{t.footer.shopify}</a></li>
        <li><a class="transition hover:text-fg" href={localizePath('/category/wordpress', locale)}>{t.footer.wordpress}</a></li>
        <li><a class="transition hover:text-fg" href={localizePath('/category/woocommerce', locale)}>{t.footer.woocommerce}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{t.footer.studioHeading}</h4>
      <ul class="mt-4 space-y-2.5 text-sm text-fg-muted">
        <li><a class="transition hover:text-fg" href={localizePath('/about', locale)}>{t.footer.about}</a></li>
        <li><a class="transition hover:text-fg" href={localizePath('/contact', locale)}>{t.footer.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-hair">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 font-mono text-xs text-fg-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} HB Studio Co. {t.footer.rights}</p>
      <p>{t.footer.builtBy}</p>
    </div>
  </div>
</footer>
