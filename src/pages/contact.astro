---
import Base from '../layouts/Base.astro';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.contact.meta.title} description={t.contact.meta.description}>
  <section class="mx-auto max-w-3xl px-5 py-20">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-accent">{t.contact.eyebrow}</p>
    <h1 class="mt-2 font-display text-4xl font-bold sm:text-5xl">{t.contact.heading}</h1>
    <p class="mt-3 max-w-xl text-muted">{t.contact.intro}</p>

    <!-- Netlify Forms: handled automatically on deploy. No backend needed. -->
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thanks"
      class="mt-10 grid gap-5"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>{t.contact.honeypotLabel}<input name="bot-field" /></label></p>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-medium">{t.contact.nameLabel}
          <input type="text" name="name" required class="rounded-xl border border-line bg-surface px-4 py-3 font-normal text-ink outline-none transition focus:border-accent" />
        </label>
        <label class="grid gap-2 text-sm font-medium">{t.contact.emailLabel}
          <input type="email" name="email" required class="rounded-xl border border-line bg-surface px-4 py-3 font-normal text-ink outline-none transition focus:border-accent" />
        </label>
      </div>
      <label class="grid gap-2 text-sm font-medium">{t.contact.subjectLabel}
        <select name="subject" class="rounded-xl border border-line bg-surface px-4 py-3 font-normal text-ink outline-none transition focus:border-accent">
          {t.contact.subjectOptions.map((opt) => <option>{opt}</option>)}
        </select>
      </label>
      <label class="grid gap-2 text-sm font-medium">{t.contact.messageLabel}
        <textarea name="message" rows="6" required class="rounded-xl border border-line bg-surface px-4 py-3 font-normal text-ink outline-none transition focus:border-accent"></textarea>
      </label>
      <button type="submit" class="justify-self-start rounded-full bg-ink px-7 py-3 font-medium text-paper transition hover:bg-accent">{t.contact.submit}</button>
    </form>
  </section>
</Base>
