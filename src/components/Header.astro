---
import { useTranslations, getLocaleFromPath, stripLocalePrefix, localizePath, getAlternatePath } from '../i18n';

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const t = useTranslations(locale);
const bare = stripLocalePrefix(path);

const links = [
  { href: '/templates', label: t.nav.templates },
  { href: '/category/shopify', label: t.nav.shopify },
  { href: '/category/wordpress', label: t.nav.wordpress },
  { href: '/category/woocommerce', label: t.nav.woocommerce },
  { href: '/about', label: t.nav.agency },
];

// The language switcher points at the equivalent page in the other
// locale (never the homepage), so a visitor reading a theme page stays
// on that same theme page when switching language.
const altHref = getAlternatePath(path);
const altLocale = locale === 'en' ? 'fr' : 'en';
const altLabel = altLocale === 'fr' ? 'Français' : 'English';
---
<!-- Two-part navigation, in the studio idiom: a thin utility strip at the very
     top, and the real navigation floating as a pill above the fold line. The
     pill is `fixed` on desktop so it stays reachable the whole way down a long
     marketing page — the primary action is never more than one glance away. -->
<header data-header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <!-- utility strip -->
  <div class="pointer-events-auto mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 text-xs">
    <a href="mailto:hello@hbstudio.co" class="hidden font-mono text-fg-muted transition hover:text-fg sm:block">hello@hbstudio.co</a>

    <span class="inline-flex items-center gap-2 rounded-full border border-hair bg-panel/70 px-3 py-1.5 font-mono backdrop-blur">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-70"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-signal"></span>
      </span>
      {t.nav.statusAvailable}
    </span>

    <a
      href={altHref}
      hreflang={altLocale}
      data-lang-switch={altLocale}
      aria-label={`${t.nav.switchTo}${altLabel}`}
      class="inline-flex items-center gap-1.5 rounded-full border border-hair bg-panel/70 px-3 py-1.5 font-mono backdrop-blur transition hover:border-hair-strong"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
      {altLocale.toUpperCase()}
    </a>
  </div>

  <!-- floating pill -->
  <div class="pointer-events-auto mx-auto mt-2 flex max-w-4xl items-center gap-2 px-4 sm:px-5">
    <nav class="on-dark flex w-full items-center gap-1 rounded-full border border-hair p-1.5 shadow-[0_18px_50px_-20px_rgba(0,0,0,0.55)] backdrop-blur-xl">
      <!-- Logotype, so the two weights and the two colours are deliberate:
           "HB" carries the mark, "Studio" reads as the word. -->
      <a href={localizePath('/', locale)} class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-full bg-signal pl-4 pr-5 font-display text-sm transition active:scale-[0.97]" aria-label={t.nav.homeAriaLabel}>
        <span class="font-bold tracking-tight text-on-signal">HB</span>
        <span class="font-medium tracking-tight text-white">Studio</span>
      </a>

      <div class="hidden flex-1 items-center justify-center gap-1 md:flex">
        {links.map((l) => (
          <a
            href={localizePath(l.href, locale)}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm transition',
              bare.startsWith(l.href) && l.href !== '/'
                ? 'bg-panel-2 text-fg'
                : 'text-fg-muted hover:bg-panel-2 hover:text-fg',
            ]}
          >{l.label}</a>
        ))}
      </div>

      <a href={localizePath('/templates', locale)} class="ml-auto hidden shrink-0 rounded-full bg-fg px-5 py-2.5 text-sm font-medium text-bg transition active:scale-[0.97] sm:block">
        {t.nav.getTemplate}
      </a>

      <!-- mobile menu -->
      <details class="relative ml-auto md:hidden">
        <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full border border-hair" aria-label={t.nav.menuAriaLabel}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-3 w-56 rounded-[var(--radius)] border border-hair bg-panel p-2 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.6)]">
          {links.map((l) => (<a href={localizePath(l.href, locale)} class="block rounded-full px-4 py-2.5 text-sm text-fg-muted transition hover:bg-panel-2 hover:text-fg">{l.label}</a>))}
          <a href={altHref} hreflang={altLocale} data-lang-switch={altLocale} class="block rounded-full px-4 py-2.5 text-sm text-fg-muted transition hover:bg-panel-2 hover:text-fg">{altLabel}</a>
          <a href={localizePath('/contact', locale)} class="mt-1 block rounded-full bg-signal px-4 py-2.5 text-center text-sm font-medium text-on-signal">{t.nav.getInTouch}</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<!-- Spacer: the header is fixed, so every page needs the height back. Kept
     here rather than in each page so a new page cannot forget it. -->
<div aria-hidden="true" class="h-[132px]"></div>
