---
import Base from '../layouts/Base.astro';
import { CMS, CMS_ORDER } from '../data/cms';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// ── PORTRAIT SLOT ────────────────────────────────────────────────────────
// Célia is a real person, so this is not a generated image and not a stock
// photo of someone else. Drop her photograph at `public/studio/celia.jpg`
// (portrait crop, at least 900×1125) and set the constant below to that path.
// Until then the frame shows a monogram, which is a deliberate design rather
// than a broken image — the page ships and sells either way.
const PORTRAIT: string | null = null;
const MONOGRAM = 'CG';
---
<Base title={t.about.meta.title} description={t.about.meta.description}>
  <!-- ── HERO ───────────────────────────────────────────────────────────── -->
  <section class="border-b border-hair">
    <div class="mx-auto max-w-5xl px-5 pb-20 pt-24">
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{t.about.hero.eyebrow}</p>
      <h1 data-reveal style="transition-delay:80ms" class="mt-5 max-w-3xl font-display text-5xl font-semibold sm:text-6xl">{t.about.hero.titlePrefix}<span class="text-signal">{t.about.hero.titleEmphasis}</span>{t.about.hero.titleSuffix}</h1>
      <p data-reveal style="transition-delay:160ms" class="mt-7 max-w-2xl text-lg leading-relaxed text-fg-muted">
        {t.about.hero.body}
      </p>
    </div>
  </section>

  <!-- ── THE FOUNDER ─────────────────────────────────────────────────────
       Portrait left, argument right. The lead is set large and the body sits
       in one measured column: this reads as an essay, which is the point — it
       is the one page on the site allowed to talk at length. -->
  <section class="border-b border-hair">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
        <figure data-reveal-scale class="lg:sticky lg:top-28 lg:self-start">
          <div class="aspect-[4/5] overflow-hidden border border-hair bg-panel">
            {PORTRAIT ? (
              <img src={PORTRAIT} alt={t.about.story.portraitAlt} class="h-full w-full object-cover" />
            ) : (
              <div class="grid h-full w-full place-items-center">
                <span class="font-display text-6xl font-semibold text-fg/15">{MONOGRAM}</span>
              </div>
            )}
          </div>
          <figcaption class="mt-4 flex items-baseline justify-between gap-3 border-t border-hair pt-4">
            <span class="font-display text-sm font-semibold">{t.about.story.portraitCaption}</span>
            <span class="font-mono text-xs text-fg-muted">{t.about.story.portraitRole}</span>
          </figcaption>
        </figure>

        <div>
          <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{t.about.story.eyebrow}</p>
          <h2 data-reveal style="transition-delay:80ms" class="mt-5 font-display text-4xl font-semibold sm:text-5xl">{t.about.story.heading}</h2>
          <p data-reveal style="transition-delay:160ms" class="mt-8 max-w-2xl text-xl leading-relaxed">{t.about.story.lead}</p>
          <div class="mt-8 max-w-2xl space-y-6 text-lg leading-relaxed text-fg-muted">
            {t.about.story.paras.map((p, i) => (
              <p data-reveal style={`transition-delay:${240 + i * 80}ms`}>{p}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHAT WE DO ──────────────────────────────────────────────────────
       Platforms as a hairline strip, not four coloured chips. The brand
       colours belong to the logos, not to our layout. -->
  <section class="mx-auto max-w-5xl px-5 py-24">
    <h2 data-reveal class="font-display text-3xl font-semibold sm:text-4xl">{t.about.whatWeDo.heading}</h2>
    <p data-reveal style="transition-delay:80ms" class="mt-6 max-w-2xl text-lg leading-relaxed text-fg-muted">
      {t.about.whatWeDo.body}
    </p>
    <dl class="mt-12 grid gap-px border border-hair bg-hair sm:grid-cols-2 lg:grid-cols-4">
      {CMS_ORDER.map((k, i) => {
        const c = CMS[k];
        return (
          <div data-reveal style={`transition-delay:${i * 70}ms`} class="bg-bg p-6">
            <dt class="font-display text-lg font-semibold">{c.label}</dt>
            <dd class="mt-2 font-mono text-xs text-fg-muted">{c.available ? t.about.whatWeDo.availableNow : t.common.comingSoon}</dd>
          </div>
        );
      })}
    </dl>
  </section>

  <!-- ── CONVICTIONS ─────────────────────────────────────────────────────
       Numbered and hanging, one per row. Four equal cards would have made
       these look like features; they are positions. -->
  <section class="border-y border-hair bg-panel">
    <div class="mx-auto max-w-5xl px-5 py-24">
      <h2 data-reveal class="font-display text-3xl font-semibold sm:text-4xl">{t.about.weBelieve.heading}</h2>
      <ol class="mt-12 border-t border-hair">
        {t.about.weBelieve.items.map((item, i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`} class="grid grid-cols-[3rem_1fr] gap-x-5 gap-y-2 border-b border-hair py-8 sm:grid-cols-[5rem_1fr] lg:grid-cols-[5rem_0.9fr_1.1fr] lg:gap-x-10">
            <span class="font-mono text-sm text-fg-muted">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display text-xl font-semibold">{item.title}</h3>
            <p class="col-start-2 leading-relaxed text-fg-muted lg:col-start-3 lg:row-start-1">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── WORK WITH US ───────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-24">
    <div data-reveal class="flex flex-col items-start justify-between gap-8 border-t border-hair pt-12 sm:flex-row sm:items-end">
      <div>
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">{t.about.workWithUs.heading}</h2>
        <p class="mt-3 max-w-md leading-relaxed text-fg-muted">{t.about.workWithUs.body}</p>
      </div>
      <a href="/contact" class="shrink-0 rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">{t.common.startProject}</a>
    </div>
  </section>
</Base>
