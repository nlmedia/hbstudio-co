---
import { useTranslations, getLocaleFromPath, stripLocalePrefix, localizePath, getAlternatePath } from '../i18n';

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const t = useTranslations(locale);
const bare = stripLocalePrefix(path);

const links = [
  { href: '/templates', label: t.nav.templates },
  { href: '/category/shopify', label: t.nav.shopify },
  { href: '/category/wordpress', label: t.nav.wordpress },
  { href: '/category/woocommerce', label: t.nav.woocommerce },
  { href: '/about', label: t.nav.agency },
];

// The language switcher points at the equivalent page in the other
// locale (never the homepage), so a visitor reading a theme page stays
// on that same theme page when switching language.
const altHref = getAlternatePath(path);
const altLocale = locale === 'en' ? 'fr' : 'en';
const altLabel = altLocale === 'fr' ? 'Français' : 'English';
---
<header data-header class="sticky top-0 z-50 transition-all duration-300 [&.is-scrolled]:border-b [&.is-scrolled]:border-line [&.is-scrolled]:bg-paper/80 [&.is-scrolled]:backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href={localizePath('/', locale)} class="group flex items-center gap-2.5" aria-label={t.nav.homeAriaLabel}>
      <span class="grid h-8 w-8 place-items-center rounded-lg grad-accent font-display text-sm font-bold text-white transition group-hover:rotate-6">HB</span>
      <span class="font-display text-[15px] font-bold leading-none">HB Studio<span class="text-accent">.</span>Co</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm text-ink/65 md:flex">
      {links.map((l) => (
        <a
          href={localizePath(l.href, locale)}
          class:list={['link-underline transition hover:text-ink', { 'text-ink font-medium': bare.startsWith(l.href) && l.href !== '/' }]}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={altHref}
        hreflang={altLocale}
        data-lang-switch={altLocale}
        aria-label={`${t.nav.switchTo}${altLabel}`}
        class="hidden items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink/60 transition hover:border-line-strong hover:text-ink sm:inline-flex"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
        {altLocale.toUpperCase()}
      </a>
      <a href={localizePath('/templates', locale)} class="hidden rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper transition hover:bg-accent sm:inline-block">{t.nav.getTemplate}</a>
      <details class="relative md:hidden">
        <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border border-line text-ink" aria-label={t.nav.menuAriaLabel}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-xl border border-line bg-surface p-2 shadow-2xl">
          {links.map((l) => (<a href={localizePath(l.href, locale)} class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-surface-2">{l.label}</a>))}
          <a href={altHref} hreflang={altLocale} data-lang-switch={altLocale} class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-surface-2">{altLabel}</a>
          <a href={localizePath('/contact', locale)} class="mt-1 block rounded-lg bg-ink px-3 py-2 text-sm font-medium text-paper">{t.nav.getInTouch}</a>
        </div>
      </details>
    </div>
  </div>
</header>
