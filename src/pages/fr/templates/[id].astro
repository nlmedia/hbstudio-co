---
// See src/pages/fr/index.astro for the rationale behind this shim pattern.
// Dynamic routes need their own getStaticPaths per file, so this one
// re-fetches the catalogue and hands the matched entry to the English
// component as a prop — the markup itself is defined only in
// src/pages/templates/[id].astro.
import EnglishTemplateDetail from '../../templates/[id].astro';
import { getTemplates } from '../../../lib/catalog';

export async function getStaticPaths() {
  const all = await getTemplates('fr');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---
<EnglishTemplateDetail entry={entry} />
