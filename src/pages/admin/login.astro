---
export const prerender = false;
const denied = Astro.url.searchParams.get('denied');
---
<!doctype html>
<html lang="fr" class="bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Connexion — HB Studio Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <style>
      *{box-sizing:border-box} body{margin:0;font-family:Inter,system-ui,sans-serif;background:#f8f7f4;color:#0e0e12}
      h1{font-family:'Space Grotesk',sans-serif}
    </style>
  </head>
  <body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:24px">
      <div style="width:100%;max-width:400px">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:28px;justify-content:center">
          <span style="display:grid;place-items:center;height:34px;width:34px;border-radius:9px;background:linear-gradient(135deg,#6d4aff,#9b6bff);color:#fff;font-family:'Space Grotesk';font-weight:700">HB</span>
          <span style="font-family:'Space Grotesk';font-weight:700;font-size:16px">HB Studio<span style="color:#6d4aff">.</span>Admin</span>
        </div>
        <div style="background:#fff;border:1px solid rgba(14,14,18,.1);border-radius:20px;padding:32px;box-shadow:0 20px 60px rgba(14,14,18,.08)">
          <h1 style="font-size:24px;font-weight:700;margin:0 0 6px">Connexion</h1>
          <p style="color:#6b6b73;font-size:14px;margin:0 0 22px">Saisissez votre e-mail admin — nous vous envoyons un lien de connexion sécurisé.</p>
          {denied && <p style="background:#fbeaea;color:#b3261e;border-radius:10px;padding:10px 14px;font-size:13px;margin:0 0 16px">Cet e-mail n'est pas autorisé pour l'admin.</p>}
          <form id="f">
            <label style="display:block;font-size:13px;font-weight:500;margin-bottom:6px">E-mail</label>
            <input id="email" type="email" required autocomplete="email" placeholder="vous@email.com" style="width:100%;border:1px solid rgba(14,14,18,.18);border-radius:12px;padding:12px 14px;font-size:15px;outline:none" />
            <button id="btn" type="submit" style="width:100%;margin-top:16px;background:#0e0e12;color:#fff;border:0;border-radius:999px;padding:13px;font-size:15px;font-weight:500;cursor:pointer">Envoyer le lien magique</button>
          </form>
          <p id="msg" style="font-size:14px;margin:16px 0 0;text-align:center"></p>
        </div>
      </div>
    </main>

    <script>
      import { createSupabaseBrowser } from '../../lib/supabase';
      const supabase = createSupabaseBrowser();
      const f = document.getElementById('f');
      const msg = document.getElementById('msg');
      const btn = document.getElementById('btn');
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        btn.setAttribute('disabled', 'true'); btn.textContent = 'Envoi…';
        const { error } = await supabase.auth.signInWithOtp({
          email,
          options: { emailRedirectTo: location.origin + '/admin/auth/callback' },
        });
        btn.removeAttribute('disabled'); btn.textContent = 'Envoyer le lien magique';
        if (error) { msg.style.color = '#b3261e'; msg.textContent = error.message; }
        else { msg.style.color = '#3a7d44'; msg.textContent = '✓ Vérifiez votre boîte mail pour le lien de connexion.'; f.reset(); }
      });
    </script>
  </body>
</html>
