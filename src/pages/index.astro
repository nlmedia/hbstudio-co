---
import Base from '../layouts/Base.astro';
import TemplateCard from '../components/TemplateCard.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import CmsLogo from '../components/CmsLogo.astro';
import { CMS, CMS_ORDER } from '../data/cms';
import { getTemplates } from '../lib/catalog';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const all = await getTemplates(locale);
const featured = all.filter((t) => t.data.featured || t.data.status === 'published').slice(0, 3);
const counts = Object.fromEntries(CMS_ORDER.map((k) => [k, all.filter((t) => t.data.cms === k && t.data.status === 'published').length]));
const availableCount = all.filter((t) => t.data.status === 'published').length;
const marquee = ['Shopify', 'WordPress', 'WooCommerce', 'Webflow', 'Framer', 'Squarespace', 'Wix'];

const steps = t.home.howItWorks.steps.map((s, i) => [String(i + 1).padStart(2, '0'), s.title, s.body]);
const faqs = t.home.faq.items.map((item) => [item.q, item.a]);

// Section index. The old build opened eight sections with the same vermilion
// uppercase eyebrow, which spent the accent eight times and gave every section
// an identical silhouette. The label text still comes from the dictionaries —
// only its treatment changed: a mono counter, set quiet, so the accent stays
// reserved for the one thing that matters in a view.
const sectionNo = (n: number) => String(n).padStart(2, '0');
---
<Base>
  <!-- ── HERO ─────────────────────────────────────────────────────────────
       Split, not centred. Copy carries the left, the product carries the
       right. Vermilion appears exactly once on this screen: one word. -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 pb-20 pt-16 sm:pt-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p data-reveal class="inline-flex items-center gap-2.5 border border-hair px-3 py-1 font-mono text-xs tracking-wide text-fg-muted">
            <span class="h-1 w-1 rounded-full bg-signal"></span>{t.home.hero.badge}
          </p>
          <h1 class="mt-7 font-display text-[clamp(2.6rem,6vw,5rem)] font-semibold leading-[0.96]">
            <span data-reveal class="block" style="transition-delay:60ms">{t.home.hero.titleLine1}</span>
            <span data-reveal class="block" style="transition-delay:140ms">{t.home.hero.titleLine2Prefix}<span class="text-signal">{t.home.hero.titleLine2Emphasis}</span>{t.home.hero.titleLine2Suffix}</span>
          </h1>
          <p data-reveal style="transition-delay:240ms" class="mt-7 max-w-xl text-lg leading-relaxed text-fg-muted">
            {t.home.hero.subtitle}
          </p>
          <div data-reveal style="transition-delay:320ms" class="mt-9 flex flex-wrap items-center gap-3">
            <a href="/templates" class="group inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">
              {t.common.browseTemplates}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/demo/atelier/index.html" target="_blank" rel="noopener" class="rounded-full border border-hair-strong px-6 py-3 font-medium transition hover:border-fg active:scale-[0.98]">{t.common.liveDemo}</a>
          </div>
          <dl data-reveal style="transition-delay:420ms" class="mt-14 grid max-w-md grid-cols-3 gap-6 border-t border-hair pt-8">
            <div><dt class="font-display text-4xl font-semibold"><span data-count={availableCount} data-suffix="+">0</span></dt><dd class="mt-1.5 font-mono text-xs uppercase tracking-wider text-fg-muted">{t.home.hero.statTemplates}</dd></div>
            <div><dt class="font-display text-4xl font-semibold"><span data-count="4">0</span></dt><dd class="mt-1.5 font-mono text-xs uppercase tracking-wider text-fg-muted">{t.home.hero.statPlatforms}</dd></div>
            <div><dt class="font-display text-4xl font-semibold"><span data-count="100" data-suffix="%">0</span></dt><dd class="mt-1.5 font-mono text-xs uppercase tracking-wider text-fg-muted">{t.home.hero.statAppFree}</dd></div>
          </dl>
        </div>

        <div data-reveal-scale style="transition-delay:240ms" class="hidden lg:block">
          <DeviceMockup desktop="/templates/atelier/home-full.jpg" mobile="/templates/atelier/home-mobile.jpg" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── MARQUEE ─── quiet band, no accent: it is context, not a claim. -->
  <section class="border-y border-hair bg-panel py-5">
    <div class="marquee" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="marquee__track">
          {marquee.map((m) => (
            <span class="flex items-center gap-3.5 font-display text-xl font-medium text-fg/20 sm:text-2xl">
              {m}<span class="text-fg/15">/</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ── CATEGORIES ─── four platforms, hairline grid rather than cards. -->
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(1)} / {t.home.categories.eyebrow}</p>
        <h2 data-reveal style="transition-delay:80ms" class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{t.home.categories.heading}</h2>
      </div>
      <a href="/templates" class="link-underline hidden text-sm font-medium sm:block">{t.home.categories.viewAll}</a>
    </div>
    <div class="mt-12 grid gap-px border border-hair bg-hair sm:grid-cols-2 lg:grid-cols-4">
      {CMS_ORDER.map((k, i) => {
        const c = CMS[k];
        return (
          <a href={`/category/${k}`} data-reveal style={`transition-delay:${i * 90}ms`} class="group flex flex-col bg-bg p-7 transition hover:bg-panel">
            <span class="grid h-11 w-11 place-items-center border border-hair" style={c.key === 'other' ? `color:${c.accent}` : undefined}>
              <CmsLogo cms={c.key} class="h-6 w-6" />
            </span>
            <h3 class="mt-6 font-display text-xl font-semibold">{c.label}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-fg-muted">{c.blurb}</p>
            <p class="mt-6 font-mono text-xs text-fg-muted transition group-hover:text-fg">
              {c.available ? t.home.categories.available(counts[k]) : t.common.comingSoon}
            </p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ── FEATURED ─────────────────────────────────────────────────────── -->
  <section class="border-y border-hair bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(2)} / {t.home.featured.eyebrow}</p>
          <h2 data-reveal style="transition-delay:80ms" class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{t.home.featured.heading}</h2>
        </div>
        <a href="/templates" class="link-underline hidden text-sm font-medium sm:block">{t.home.featured.viewAll}</a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry) => <TemplateCard entry={entry} />)}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ───────────────────────────────────────────────────
       Editorial, not four equal cards: a heading that stays put while the
       steps scroll past it. Different layout family from every other
       section, which is the whole point. -->
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(3)} / {t.home.howItWorks.eyebrow}</p>
        <h2 data-reveal style="transition-delay:80ms" class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{t.home.howItWorks.heading}</h2>
      </div>
      <ol class="border-t border-hair">
        {steps.map(([n, title, body], i) => (
          <li data-reveal style={`transition-delay:${i * 80}ms`} class="grid grid-cols-[3rem_1fr] gap-5 border-b border-hair py-7 sm:grid-cols-[4.5rem_1fr]">
            <span class="font-mono text-sm text-fg-muted">{n}</span>
            <div>
              <h3 class="font-display text-xl font-semibold">{title}</h3>
              <p class="mt-2 max-w-lg leading-relaxed text-fg-muted">{body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── WHY ─── hairline grid, one shared rule between every cell. -->
  <section class="border-y border-hair bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(4)} / {t.home.why.eyebrow}</p>
      <h2 data-reveal style="transition-delay:80ms" class="mt-4 max-w-2xl font-display text-4xl font-semibold sm:text-5xl">{t.home.why.heading}</h2>
      <div class="mt-14 grid gap-px border border-hair bg-hair sm:grid-cols-2 lg:grid-cols-3">
        {t.home.why.items.map((item, i) => (
          <div data-reveal style={`transition-delay:${(i % 3) * 80}ms`} class="bg-panel p-7 transition hover:bg-panel-2">
            <div class="grid h-11 w-11 place-items-center border border-hair text-lg">{item.icon}</div>
            <h3 class="mt-6 font-display text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RESPONSIVE ───────────────────────────────────────────────────
       Left-aligned and allowed to bleed off the right edge. The previous
       build centred this, which made it the third centred stack in a row. -->
  <section class="overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <div class="grid items-center gap-14 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(5)} / {t.home.responsive.eyebrow}</p>
          <h2 data-reveal style="transition-delay:80ms" class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{t.home.responsive.heading}</h2>
          <p data-reveal style="transition-delay:160ms" class="mt-5 max-w-md leading-relaxed text-fg-muted">{t.home.responsive.body}</p>
        </div>
        <div data-reveal-scale style="transition-delay:240ms" class="lg:-mr-32">
          <DeviceMockup desktop="/templates/atelier/home-full.jpg" mobile="/templates/atelier/home-mobile.jpg" />
        </div>
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ─────────────────────────────────────────────────── -->
  <section class="border-y border-hair bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-24">
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(6)} / {t.home.testimonials.eyebrow}</p>
      <h2 data-reveal style="transition-delay:80ms" class="mt-4 max-w-2xl font-display text-4xl font-semibold sm:text-5xl">{t.home.testimonials.heading}</h2>
      <div class="mt-12 grid gap-px border border-hair bg-hair sm:grid-cols-2 lg:grid-cols-3">
        {t.home.testimonials.items.map((item, i) => (
          <figure data-reveal style={`transition-delay:${(i % 3) * 80}ms`} class="flex flex-col bg-panel p-7">
            <div class="flex gap-0.5 text-fg-muted" aria-label={t.home.testimonials.ratingAriaLabel(item.rating)}>
              {Array.from({ length: item.rating }).map(() => (<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"/></svg>))}
            </div>
            <blockquote class="mt-5 flex-1 text-[15px] leading-relaxed">“{item.quote}”</blockquote>
            <figcaption class="mt-7 flex items-center gap-3 border-t border-hair pt-5">
              <span class="grid h-9 w-9 place-items-center border border-hair font-mono text-xs">{item.name.split(' ').map((n) => n[0]).join('')}</span>
              <span>
                <span class="block text-sm font-medium">{item.name}</span>
                <span class="block text-xs text-fg-muted">{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ─── two columns: the question set is a list, not a stack of
       floating cards. Hairlines do the grouping. -->
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{sectionNo(7)} / {t.home.faq.eyebrow}</p>
        <h2 data-reveal style="transition-delay:80ms" class="mt-4 font-display text-4xl font-semibold sm:text-5xl">{t.home.faq.heading}</h2>
      </div>
      <div class="border-t border-hair">
        {faqs.map(([q, a], i) => (
          <details data-reveal style={`transition-delay:${Math.min(i, 4) * 50}ms`} class="group border-b border-hair">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium transition hover:text-fg-muted">
              {q}
              <span class="grid h-6 w-6 shrink-0 place-items-center border border-hair transition group-open:rotate-45">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-6 leading-relaxed text-fg-muted">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTER ───────────────────────────────────────────────────── -->
  <section class="border-t border-hair bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div data-reveal class="grid items-center gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl font-semibold sm:text-4xl">{t.home.newsletter.heading}</h2>
          <p class="mt-3 max-w-md leading-relaxed text-fg-muted">{t.home.newsletter.body}</p>
        </div>
        <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" class="flex flex-col gap-3 sm:flex-row">
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden"><label>{t.home.newsletter.honeypotLabel}<input name="bot-field" /></label></p>
          <input type="email" name="email" required placeholder={t.home.newsletter.placeholder} class="w-full rounded-full border border-hair-strong bg-bg px-5 py-3.5 outline-none transition focus:border-signal" />
          <button type="submit" class="shrink-0 rounded-full bg-fg px-6 py-3.5 font-medium text-bg transition active:scale-[0.98]">{t.home.newsletter.submit}</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────────────
       The one inverted block on the page, and the second and last place
       vermilion is spent. Text on vermilion is ink, never white: white on
       this red is 3.5:1 and fails AA. -->
  <section class="bg-fg text-bg">
    <div class="mx-auto max-w-4xl px-5 py-28 text-center">
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-bg/50">{t.home.customCta.eyebrow}</p>
      <h2 data-reveal style="transition-delay:80ms" class="mt-5 font-display text-4xl font-semibold sm:text-6xl">{t.home.customCta.headingPrefix}<span class="text-signal">{t.home.customCta.headingEmphasis}</span>{t.home.customCta.headingSuffix}</h2>
      <p data-reveal style="transition-delay:160ms" class="mx-auto mt-5 max-w-md leading-relaxed text-bg/60">{t.home.customCta.body}</p>
      <div data-reveal style="transition-delay:240ms" class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="rounded-full bg-bg px-7 py-3.5 font-medium text-fg transition active:scale-[0.98]">{t.common.startProject}</a>
        <a href="/templates" class="rounded-full border border-bg/25 px-7 py-3.5 font-medium transition hover:border-bg/60 active:scale-[0.98]">{t.common.browseTemplates}</a>
      </div>
    </div>
  </section>
</Base>
