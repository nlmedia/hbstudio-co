---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, getLocaleFromPath, localizePath, useTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const {
  title = t.base.defaultTitle,
  description = t.base.defaultDescription,
  image = '/brand/og.jpg',
} = Astro.props;

// Astro.url.pathname already reflects the locale actually being rendered
// (e.g. /fr/templates/atelier). Run it through localizePath for the
// *current* locale too so the canonical URL is normalized the same way
// as the self-referencing hreflang alternate below (no trailing-slash
// mismatch between the two).
const canonical = new URL(localizePath(Astro.url.pathname, locale), Astro.site);

// Reciprocal hreflang alternates: one link per configured locale, plus a
// language-neutral x-default pointing at the (unprefixed) English page.
const alternateUrls = LOCALES.map((l) => ({
  locale: l,
  href: new URL(localizePath(Astro.url.pathname, l), Astro.site),
}));
const xDefaultUrl = new URL(localizePath(Astro.url.pathname, 'en'), Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateUrls.map(({ locale: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <!-- Ground and text colour come from `html` in global.css so the theme flips
       in one place. Do not put bg-*/text-* utilities back on the body. -->
  <body class="antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:bg-signal focus:px-4 focus:py-2 focus:text-on-signal">{t.base.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div id="toast" role="status" aria-live="polite"></div>

    {/*
      ⚠️ `define:vars` ships this block to the browser VERBATIM — Astro does not
      compile it. Plain JavaScript only: a single TypeScript annotation here
      (`as HTMLElement`, `msg: string`) is a syntax error that kills the whole
      script at parse time, silently. That once left every `[data-reveal]`
      element stuck at opacity 0 with nothing in the console pointing at it.
    */}
    <script
      define:vars={{
        i18nRedirecting: t.base.redirecting,
        i18nCheckoutSoon: t.base.checkoutSoon,
        i18nCheckoutUnavailable: t.base.checkoutUnavailable,
        i18nNetworkError: t.base.networkError,
      }}
    >
      // Scroll reveals
      const els = document.querySelectorAll('[data-reveal], [data-reveal-scale]');
      if (els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      }

      // Animated counters: <span data-count="1200" data-suffix="+">
      const counters = document.querySelectorAll('[data-count]');
      if (counters.length) {
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target;
            cio.unobserve(el);
            const target = parseFloat(el.dataset.count || '0');
            const suffix = el.dataset.suffix || '';
            const dur = 1400; const t0 = performance.now();
            const tick = (now) => {
              const p = Math.min((now - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased).toString() + suffix;
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.6 });
        counters.forEach((c) => cio.observe(c));
      }

      // Language switcher: remember the visitor's explicit choice so the
      // Netlify edge redirect in netlify.toml (root "/", browser-language
      // based) never overrides it again. `nf_lang` is Netlify's own cookie
      // for this — it takes priority over the Accept-Language header on
      // every later request, no server code or library needed on our end.
      // We only set it here, on click; we never read or clear it since
      // Netlify's edge is the sole consumer.
      document.querySelectorAll('[data-lang-switch]').forEach((a) => {
        a.addEventListener('click', () => {
          const lang = a.getAttribute('data-lang-switch');
          if (!lang) return;
          document.cookie = `nf_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
        });
      });

      // Header shadow on scroll
      const header = document.querySelector('[data-header]');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Toast helper
      const toast = document.getElementById('toast');
      let toastTimer;
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3600);
      }

      // Stripe Checkout — POST to the Netlify function, then redirect.
      // Until STRIPE_SECRET_KEY is set in Netlify, the function returns
      // "not_configured" and we show a friendly "opens soon" toast.
      document.querySelectorAll('[data-checkout]').forEach((b) => {
        b.addEventListener('click', async (e) => {
          e.preventDefault();
          const el = b;
          if (el.getAttribute('aria-busy') === 'true') return;
          const slug = el.getAttribute('data-checkout');
          const tier = el.getAttribute('data-tier') || 'single';
          const label = el.textContent;
          el.setAttribute('aria-busy', 'true');
          el.textContent = i18nRedirecting;
          try {
            const r = await fetch('/api/checkout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, tier }),
            });
            const data = await r.json().catch(() => ({}));
            if (data && data.url) { window.location.href = data.url; return; }
            if (data && data.error === 'not_configured') showToast(i18nCheckoutSoon);
            else showToast(i18nCheckoutUnavailable);
          } catch {
            showToast(i18nNetworkError);
          }
          el.removeAttribute('aria-busy');
          if (label) el.textContent = label;
        });
      });
    </script>
  </body>
</html>
