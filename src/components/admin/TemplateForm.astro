---
interface Props { t?: any; action: string; submitLabel?: string; }
const { t = {}, action, submitLabel = 'Save' } = Astro.props;
const arr = (v: any) => (Array.isArray(v) ? v.join('\n') : '');
const field = 'w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-sm outline-none transition focus:border-accent';
const label = 'block text-xs font-medium text-ink/70 mb-1.5';
---
<form method="POST" action={action} class="grid max-w-3xl gap-6">
  <div class="grid gap-4 sm:grid-cols-2">
    <label><span class={label}>Titre</span><input class={field} name="title" required value={t.title ?? ''} /></label>
    <label><span class={label}>Slug (URL)</span><input class={field} name="slug" required value={t.slug ?? ''} placeholder="atelier" /></label>
  </div>
  <div class="grid gap-4 sm:grid-cols-4">
    <label><span class={label}>Plateforme</span>
      <select class={field} name="cms">
        {['shopify','wordpress','woocommerce','other'].map((o) => <option value={o} selected={t.cms===o}>{o}</option>)}
      </select>
    </label>
    <label><span class={label}>Statut</span>
      <select class={field} name="status">
        {[['draft','Brouillon'],['published','Publié'],['coming-soon','Bientôt']].map(([o, lbl]) => <option value={o} selected={(t.status??'draft')===o}>{lbl}</option>)}
      </select>
    </label>
    <label><span class={label}>Prix (€, vide = aucun)</span><input class={field} name="price" type="number" step="1" value={t.price ?? ''} /></label>
    <label><span class={label}>Prix Extended — 5 sites (€, vide = niveau indisponible)</span><input class={field} name="extended_price" type="number" step="1" value={t.extended_price ?? ''} /></label>
    <label><span class={label}>Ordre de tri</span><input class={field} name="sort_order" type="number" value={t.sort_order ?? 100} /></label>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <label><span class={label}>Slug du thème WordPress (dossier)</span><input class={field} name="theme_slug" value={t.theme_slug ?? ''} placeholder="ex. hb-atelier" /></label>
    <label><span class={label}>WordPress minimum</span><input class={field} name="requires_wp" value={t.requires_wp ?? ''} placeholder="ex. 6.4" /></label>
    <label><span class={label}>PHP minimum</span><input class={field} name="requires_php" value={t.requires_php ?? ''} placeholder="ex. 8.1" /></label>
  </div>
  <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="featured" checked={!!t.featured} /> Mis en avant sur l'accueil</label>

  <fieldset class="grid gap-4 rounded-2xl border border-line p-4 sm:grid-cols-2">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wide text-muted">Promotion (optionnel)</legend>
    <label><span class={label}>Prix promo (€, vide = pas de promo)</span><input class={field} name="sale_price" type="number" step="1" value={t.sale_price ?? ''} placeholder="ex. 129" /></label>
    <label>
      <span class={label}>Fin de la promo (vide = sans limite)</span>
      <input class={field} type="datetime-local" data-sale-ends-local />
      <input type="hidden" name="sale_ends_at" value={t.sale_ends_at ?? ''} data-sale-ends-iso />
    </label>
    <p class="text-xs text-muted sm:col-span-2">Le prix promo doit être inférieur au prix normal. Le prix barré et le compte à rebours s'affichent automatiquement sur le site jusqu'à la date de fin.</p>
  </fieldset>

  <label><span class={label}>Accroche</span><input class={field} name="tagline" value={t.tagline ?? ''} /></label>
  <label><span class={label}>Description courte</span><textarea class={field} name="description" rows="3">{t.description ?? ''}</textarea></label>
  <label><span class={label}>Contenu (paragraphes, ligne vide entre chaque)</span><textarea class={field} name="body" rows="4">{t.body ?? ''}</textarea></label>

  <fieldset class="grid gap-4 rounded-2xl border border-line p-4">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wide text-muted">Images</legend>
    {[['cover','Couverture (carte)'],['preview','Pleine page desktop (mockup)'],['preview_mobile','Pleine page mobile (téléphone)']].map(([n, lbl]) => (
      <div>
        <span class={label}>{lbl}</span>
        <div class="flex gap-2">
          <input class={field} name={n} value={t[n] ?? ''} placeholder="/templates/... ou URL importée" data-img-field={n} />
          <label class="shrink-0 cursor-pointer rounded-xl border border-line px-3 py-2.5 text-xs font-medium transition hover:bg-surface-2">
            Importer<input type="file" accept="image/*" class="hidden" data-img-upload={n} />
          </label>
        </div>
      </div>
    ))}
  </fieldset>

  <div class="grid gap-4 sm:grid-cols-3">
    <label><span class={label}>URLs galerie (une/ligne)</span><textarea class={field} name="gallery" rows="4">{arr(t.gallery)}</textarea></label>
    <label><span class={label}>Caractéristiques (une/ligne)</span><textarea class={field} name="features" rows="4">{arr(t.features)}</textarea></label>
    <label><span class={label}>Tags (un/ligne)</span><textarea class={field} name="tags" rows="4">{arr(t.tags)}</textarea></label>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <label><span class={label}>URL démo</span><input class={field} name="demo_url" value={t.demo_url ?? ''} /></label>
    <label><span class={label}>URL achat</span><input class={field} name="buy_url" value={t.buy_url ?? ''} /></label>
    <label><span class={label}>URL docs</span><input class={field} name="docs_url" value={t.docs_url ?? ''} /></label>
  </div>

  <fieldset class="grid gap-2 rounded-2xl border border-line p-4">
    <legend class="px-2 text-xs font-semibold uppercase tracking-wide text-muted">Fichier livrable (téléchargement après achat)</legend>
    <div class="flex gap-2">
      <input class={field} name="deliverable" value={t.deliverable ?? ''} placeholder="ex. atelier/atelier-v1.0.0.zip (chemin dans le stockage privé)" data-deliverable-field />
      <label class="shrink-0 cursor-pointer rounded-xl border border-line px-3 py-2.5 text-xs font-medium transition hover:bg-surface-2">
        Importer le ZIP<input type="file" accept=".zip,application/zip" class="hidden" data-deliverable-upload />
      </label>
    </div>
    <p class="text-xs text-muted">Stocké dans un bucket privé. Livré uniquement via un lien signé temporaire après un paiement réussi.</p>
  </fieldset>

  <div class="flex items-center gap-3 pt-2">
    <button type="submit" class="rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-paper transition hover:bg-accent">{submitLabel}</button>
    <a href="/admin/templates" class="text-sm font-medium text-muted hover:text-ink">Annuler</a>
    <span id="upmsg" class="text-xs text-muted"></span>
  </div>
</form>

<script>
  import { createSupabaseBrowser } from '../../lib/supabase';
  const supabase = createSupabaseBrowser();
  const msg = document.getElementById('upmsg');

  // Promo end date: visible <datetime-local> (local time) ⇄ hidden ISO (UTC) submitted to the DB
  const localInput = document.querySelector('[data-sale-ends-local]') as HTMLInputElement | null;
  const isoInput = document.querySelector('[data-sale-ends-iso]') as HTMLInputElement | null;
  if (localInput && isoInput) {
    const pad = (n: number) => String(n).padStart(2, '0');
    if (isoInput.value) {
      const d = new Date(isoInput.value);
      if (!isNaN(d.getTime())) {
        localInput.value = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
      }
    }
    localInput.addEventListener('change', () => {
      isoInput.value = localInput.value ? new Date(localInput.value).toISOString() : '';
    });
  }
  document.querySelectorAll('[data-img-upload]').forEach((input) => {
    input.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const key = (input as HTMLElement).getAttribute('data-img-upload');
      const path = `${Date.now()}-${file.name.replace(/[^a-z0-9.\-]/gi, '_')}`;
      if (msg) msg.textContent = 'Uploading ' + file.name + '…';
      const { error } = await supabase.storage.from('templates').upload(path, file, { upsert: true });
      if (error) { if (msg) msg.textContent = 'Upload failed: ' + error.message; return; }
      const { data } = supabase.storage.from('templates').getPublicUrl(path);
      const target = document.querySelector(`[data-img-field="${key}"]`) as HTMLInputElement;
      if (target) target.value = data.publicUrl;
      if (msg) msg.textContent = '✓ Uploaded';
    });
  });

  // Deliverable (private bucket) — uploaded server-side via an admin-only endpoint.
  const delInput = document.querySelector('[data-deliverable-upload]') as HTMLInputElement | null;
  delInput?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const slug = (document.querySelector('[name="slug"]') as HTMLInputElement)?.value || 'misc';
    if (msg) msg.textContent = `Envoi de ${file.name}… (cela peut prendre un moment)`;
    const fd = new FormData();
    fd.append('file', file);
    fd.append('slug', slug);
    try {
      const res = await fetch('/admin/api/upload-deliverable', { method: 'POST', body: fd });
      const json = await res.json();
      if (!res.ok) { if (msg) msg.textContent = 'Échec : ' + (json.error || res.status); return; }
      const target = document.querySelector('[data-deliverable-field]') as HTMLInputElement;
      if (target) target.value = json.path;
      if (msg) msg.textContent = '✓ Fichier livrable importé';
    } catch (err) {
      if (msg) msg.textContent = 'Échec de l\'upload : ' + (err as Error).message;
    }
  });
</script>
