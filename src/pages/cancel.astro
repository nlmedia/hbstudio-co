---
import Base from '../layouts/Base.astro';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.cancel.meta.title} description={t.cancel.meta.description}>
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-[var(--radius)] bg-panel-2 text-3xl">↩</div>
    <h1 class="mt-6 font-display text-4xl font-medium">{t.cancel.heading}</h1>
    <p class="mt-3 text-fg-muted">{t.cancel.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/#pricing" class="rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">{t.cancel.backToPricing}</a>
      <a href="/templates" class="rounded-full border border-hair-strong px-6 py-3 font-medium transition hover:bg-panel-2">{t.common.browseTemplates}</a>
    </div>
  </section>
</Base>
