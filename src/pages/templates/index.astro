---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { CMS, CMS_ORDER } from '../../data/cms';

const all = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="All templates — HB Studio Co" description="Browse premium templates for Shopify, WordPress, WooCommerce and more.">
  <section class="relative overflow-hidden">
    <div class="orb -right-40 -top-40 h-[32rem] w-[32rem]" style="background:rgba(124,92,255,0.18)"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-20">
      <p data-reveal class="text-sm font-medium uppercase tracking-[0.2em] text-accent-2">Catalogue</p>
      <h1 data-reveal style="transition-delay:80ms" class="mt-3 font-display text-5xl font-bold sm:text-6xl">All templates</h1>
      <p data-reveal style="transition-delay:160ms" class="mt-4 max-w-xl text-muted">Conversion-ready templates, designed and built in-house. Filter by platform.</p>

      <nav data-reveal style="transition-delay:240ms" class="mt-9 flex flex-wrap gap-2">
        <a href="/templates" class="rounded-full bg-paper px-4 py-2 text-sm font-medium text-ink">All</a>
        {CMS_ORDER.map((k) => (
          <a href={`/category/${k}`} class="rounded-full border border-line px-4 py-2 text-sm font-medium text-paper/65 transition hover:border-line-strong hover:text-paper">{CMS[k].label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((entry) => <TemplateCard entry={entry} />)}
    </div>
  </section>
</Base>
