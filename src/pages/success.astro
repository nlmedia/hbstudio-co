---
import Base from '../layouts/Base.astro';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.success.meta.title} description={t.success.meta.description}>
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-[var(--radius)] bg-signal text-3xl text-on-signal">✓</div>
    <h1 class="mt-6 font-display text-4xl font-medium">{t.success.heading}</h1>
    <p class="mt-3 text-fg-muted">{t.success.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/templates" class="rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">{t.success.browseMore}</a>
      <a href="/contact" class="rounded-full border border-hair-strong px-6 py-3 font-medium transition hover:bg-panel-2">{t.success.needHelp}</a>
    </div>
    <p class="mt-6 text-xs text-fg-muted" id="ref"></p>
  </section>
  <script define:vars={{ i18nOrderReference: t.success.orderReference }}>
    const id = new URLSearchParams(location.search).get('session_id');
    if (id) document.getElementById('ref').textContent = i18nOrderReference + id.slice(-12);
  </script>
</Base>
