---
export const prerender = false;
import Admin from '../../../layouts/Admin.astro';

const supabase = Astro.locals.supabase!;
const email = Astro.locals.user?.email ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').trim();
let templatesQuery = supabase
  .from('hb_templates')
  .select('id, slug, title, cms, status, price, sale_price, sale_ends_at, currency, cover, sort_order')
  .order('sort_order', { ascending: true });
if (q) templatesQuery = templatesQuery.ilike('title', `%${q}%`);
const { data: templates } = await templatesQuery;

const flash = Astro.url.searchParams.get('created') ? 'Template créé.'
  : Astro.url.searchParams.get('saved') ? 'Modifications enregistrées.'
  : Astro.url.searchParams.get('deleted') ? 'Template supprimé.' : '';

const badge: Record<string, string> = {
  published: 'bg-[#e6f4ea] text-[#1e7d34]',
  draft: 'bg-surface-2 text-muted',
  'coming-soon': 'bg-accent-soft text-accent',
};
const statusLabel: Record<string, string> = { published: 'Publié', draft: 'Brouillon', 'coming-soon': 'Bientôt' };
const isOnSale = (t: any) =>
  t.price != null && t.sale_price != null && Number(t.sale_price) < Number(t.price) &&
  (!t.sale_ends_at || new Date(t.sale_ends_at).getTime() > Date.now());
---
<Admin title="Templates" active="templates" email={email}>
  <div class="mb-6 flex items-center justify-between gap-4">
    <p class="text-sm text-muted">
      {templates?.length ?? 0} template{(templates?.length ?? 0) > 1 ? 's' : ''}
      {q && <> · résultats pour « {q} » <a href="/admin/templates" class="text-accent hover:underline">réinitialiser</a></>}
    </p>
    <a href="/admin/templates/new" class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition hover:bg-accent">+ Nouveau template</a>
  </div>

  {flash && <p class="mb-5 rounded-xl bg-[#e6f4ea] px-4 py-3 text-sm text-[#1e7d34]">{flash}</p>}

  <div class="overflow-hidden rounded-2xl border border-line bg-surface">
    <table class="w-full text-sm">
      <thead class="border-b border-line text-left text-xs uppercase tracking-wide text-muted">
        <tr>
          <th class="px-5 py-3 font-medium">Template</th>
          <th class="px-5 py-3 font-medium">Plateforme</th>
          <th class="px-5 py-3 font-medium">Statut</th>
          <th class="px-5 py-3 font-medium">Prix</th>
          <th class="px-5 py-3 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {(templates ?? []).map((t) => (
          <tr class="hover:bg-surface-2/50">
            <td class="px-5 py-3">
              <a href={`/admin/templates/${t.id}`} class="flex items-center gap-3 font-medium hover:text-accent">
                {t.cover
                  ? <img src={t.cover} alt="" class="h-9 w-12 rounded-md object-cover" />
                  : <span class="grid h-9 w-12 place-items-center rounded-md bg-surface-2 text-[10px] text-muted">—</span>}
                {t.title}
              </a>
            </td>
            <td class="px-5 py-3 capitalize text-muted">{t.cms}</td>
            <td class="px-5 py-3"><span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', badge[t.status] ?? 'bg-surface-2']}>{statusLabel[t.status] ?? t.status}</span></td>
            <td class="px-5 py-3">
              {t.price == null ? '—' : isOnSale(t) ? (
                <span class="flex items-baseline gap-1.5">
                  <span class="text-xs text-muted line-through">{t.currency}{t.price}</span>
                  <span class="font-medium text-[#e23b3b]">{t.currency}{t.sale_price}</span>
                  <span class="rounded bg-[#fbeaea] px-1.5 py-0.5 text-[10px] font-semibold text-[#e23b3b]">PROMO</span>
                </span>
              ) : `${t.currency}${t.price}`}
            </td>
            <td class="px-5 py-3">
              <div class="flex items-center justify-end gap-2">
                <a href={`/admin/templates/${t.id}`} class="rounded-lg border border-line px-3 py-1.5 text-xs font-medium transition hover:bg-surface-2">Modifier</a>
                <form method="POST" action={`/admin/templates/${t.id}`}>
                  <input type="hidden" name="_action" value={t.status === 'published' ? 'unpublish' : 'publish'} />
                  <button class="rounded-lg border border-line px-3 py-1.5 text-xs font-medium transition hover:bg-surface-2">
                    {t.status === 'published' ? 'Dépublier' : 'Publier'}
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-muted">Les templates « Publié » et « Bientôt » apparaissent sur le site public. Après modification, le site se met à jour au prochain build (hook de re-build automatique à venir).</p>
</Admin>
