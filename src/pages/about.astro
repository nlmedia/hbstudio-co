---
import Base from '../layouts/Base.astro';
import { CMS, CMS_ORDER } from '../data/cms';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.about.meta.title} description={t.about.meta.description}>
  <section class="relative overflow-hidden border-b border-hair">
    <div class="orb -right-40 -top-40 h-[36rem] w-[36rem]" style="background:rgba(124,92,255,0.22)"></div>
    <div class="relative mx-auto max-w-4xl px-5 pb-20 pt-24">
      <p data-reveal class="text-sm font-medium uppercase tracking-[0.2em] text-signal-dim">{t.about.hero.eyebrow}</p>
      <h1 data-reveal style="transition-delay:80ms" class="mt-3 font-display text-5xl font-bold leading-tight sm:text-6xl">{t.about.hero.titlePrefix}<span class="text-grad">{t.about.hero.titleEmphasis}</span>{t.about.hero.titleSuffix}</h1>
      <p data-reveal style="transition-delay:160ms" class="mt-6 max-w-2xl text-lg text-fg/65">
        {t.about.hero.body}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-20">
    <h2 data-reveal class="font-display text-3xl font-bold">{t.about.whatWeDo.heading}</h2>
    <p data-reveal style="transition-delay:80ms" class="mt-4 text-lg leading-relaxed text-fg/75">
      {t.about.whatWeDo.body}
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {CMS_ORDER.map((k, i) => {
        const c = CMS[k];
        return (
          <div data-reveal style={`transition-delay:${i * 70}ms`} class="flex items-center gap-4 rounded-2xl border border-hair bg-panel p-5 transition hover:bg-panel-2">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl text-white" style={`background:${c.accent}`}>
              <span class="font-display font-bold">{c.label[0]}</span>
            </span>
            <div>
              <p class="font-display font-semibold">{c.label}</p>
              <p class="text-sm text-fg-muted">{c.available ? t.about.whatWeDo.availableNow : t.common.comingSoon}</p>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="border-y border-hair bg-panel/30">
    <div class="mx-auto max-w-4xl px-5 py-20">
      <h2 data-reveal class="font-display text-3xl font-bold">{t.about.weBelieve.heading}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {t.about.weBelieve.items.map((item, i) => (
          <div data-reveal style={`transition-delay:${(i % 2) * 80}ms`}>
            <h3 class="font-display text-lg font-semibold text-signal-dim">{item.title}</h3>
            <p class="mt-1 text-fg-muted">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-24 text-center">
    <h2 data-reveal class="font-display text-3xl font-bold">{t.about.workWithUs.heading}</h2>
    <p data-reveal style="transition-delay:80ms" class="mx-auto mt-3 max-w-md text-fg-muted">{t.about.workWithUs.body}</p>
    <a href="/contact" data-reveal style="transition-delay:160ms" class="mt-7 inline-block rounded-full bg-fg px-6 py-3 font-medium text-bg transition hover:bg-signal">{t.common.startProject}</a>
  </section>
</Base>
