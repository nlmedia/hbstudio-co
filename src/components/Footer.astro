---
import { useTranslations, getLocaleFromPath, localizePath } from '../i18n';

const year = new Date().getFullYear();
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<footer class="border-t border-hair bg-fg text-bg">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg grad-accent font-display text-sm font-bold text-white">HB</span>
        <span class="font-display text-[15px] font-bold">HB Studio<span class="text-signal">.</span>Co</span>
      </div>
      <p class="mt-4 max-w-sm text-sm text-bg/60">{t.footer.tagline}</p>
    </div>
    <div>
      <h4 class="font-display text-sm font-semibold text-bg/90">{t.footer.catalogueHeading}</h4>
      <ul class="mt-3 space-y-2 text-sm text-bg/60">
        <li><a class="hover:text-bg" href={localizePath('/templates', locale)}>{t.footer.allTemplates}</a></li>
        <li><a class="hover:text-bg" href={localizePath('/category/shopify', locale)}>{t.footer.shopify}</a></li>
        <li><a class="hover:text-bg" href={localizePath('/category/wordpress', locale)}>{t.footer.wordpress}</a></li>
        <li><a class="hover:text-bg" href={localizePath('/category/woocommerce', locale)}>{t.footer.woocommerce}</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-display text-sm font-semibold text-bg/90">{t.footer.studioHeading}</h4>
      <ul class="mt-3 space-y-2 text-sm text-bg/60">
        <li><a class="hover:text-bg" href={localizePath('/about', locale)}>{t.footer.about}</a></li>
        <li><a class="hover:text-bg" href={localizePath('/contact', locale)}>{t.footer.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-bg/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} HB Studio Co. {t.footer.rights}</p>
      <p>{t.footer.builtBy}</p>
    </div>
  </div>
</footer>
