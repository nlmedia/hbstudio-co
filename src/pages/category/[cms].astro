---
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import CmsLogo from '../../components/CmsLogo.astro';
import { CMS, CMS_ORDER } from '../../data/cms';
import { getTemplates } from '../../lib/catalog';
import { useTranslations, getLocaleFromPath } from '../../i18n';

export async function getStaticPaths() {
  return CMS_ORDER.map((cms) => ({ params: { cms } }));
}

const { cms } = Astro.params;
const c = CMS[cms as keyof typeof CMS];
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const all = (await getTemplates(locale)).filter((entry) => entry.data.cms === cms);
---
<Base title={t.category.meta.title(c.label)} description={c.blurb}>
  <section class="relative overflow-hidden border-b border-hair">
    <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-16">
      <nav class="flex flex-wrap gap-2">
        <a href="/templates" class="rounded-full border border-hair px-4 py-2 text-sm font-medium text-fg/65 transition hover:border-hair-strong hover:text-fg">{t.common.all}</a>
        {CMS_ORDER.map((k) => (
          <a href={`/category/${k}`} class:list={['rounded-full px-4 py-2 text-sm font-medium transition', k === cms ? 'bg-fg text-bg' : 'border border-hair text-fg/65 hover:border-hair-strong hover:text-fg']}>{CMS[k].label}</a>
        ))}
      </nav>
      <div data-reveal class="mt-9 flex items-center gap-4">
        <span class="grid h-14 w-14 place-items-center border border-hair bg-bg" style={c.key === 'other' ? `color:${c.accent}` : undefined}>
          <CmsLogo cms={c.key} class="h-8 w-8" />
        </span>
        <div>
          <h1 class="font-display text-4xl font-medium sm:text-5xl">{c.label}</h1>
          <p class="mt-1.5 text-fg-muted">{c.blurb}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    {all.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {all.map((entry) => <TemplateCard entry={entry} />)}
      </div>
    ) : (
      <div data-reveal-scale class="rounded-[var(--radius)] border border-dashed border-hair-strong bg-panel p-14 text-center">
        <h2 class="font-display text-2xl font-medium">{t.category.comingHeading(c.label)}</h2>
        <p class="mx-auto mt-3 max-w-md leading-relaxed text-fg-muted">{t.category.comingBody(c.label)}</p>
        <a href="/contact" class="mt-8 inline-block rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">{t.common.notifyMe}</a>
      </div>
    )}
  </section>
</Base>
