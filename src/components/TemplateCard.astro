---
import { CMS } from '../data/cms';
interface Props { entry: any; }
const { entry } = Astro.props;
const d = entry.data;
const cms = CMS[d.cms as keyof typeof CMS];
const href = `/templates/${entry.id}`;
const soon = d.status === 'coming-soon';
---
<a href={href} data-reveal class="group block overflow-hidden rounded-2xl border border-line bg-surface transition duration-300 hover:-translate-y-1.5 hover:border-line-strong hover:bg-surface-2 hover:shadow-[0_30px_70px_-25px_rgba(124,92,255,0.45)]">
  <div class="relative aspect-[16/11] overflow-hidden bg-surface-2">
    {d.cover ? (
      <img src={d.cover} alt={d.title} loading="lazy" class="h-full w-full object-cover object-top transition duration-[650ms] ease-out group-hover:scale-[1.06]" />
    ) : (
      <div class="flex h-full w-full items-center justify-center">
        <span class="font-display text-3xl font-bold text-ink/10">{d.title}</span>
      </div>
    )}
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/40 to-transparent opacity-0 transition group-hover:opacity-100"></div>
    <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-ink/80 px-2.5 py-1 text-xs font-medium backdrop-blur" style={`color:${cms.accent}`}>
      <span class="h-2 w-2 rounded-full" style={`background:${cms.accent}`}></span>{cms.label}
    </span>
    {soon && <span class="absolute right-3 top-3 rounded-full bg-paper px-2.5 py-1 text-xs font-medium text-ink">Coming soon</span>}
  </div>
  <div class="p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-lg font-semibold">{d.title}</h3>
      {d.price != null ? (
        <span class="shrink-0 font-display text-lg font-bold">{d.currency}{d.price}</span>
      ) : (
        <span class="shrink-0 text-sm text-muted">—</span>
      )}
    </div>
    <p class="mt-1 text-sm text-muted">{d.tagline}</p>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent-2">
      {soon ? 'Notify me' : 'View template'}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
