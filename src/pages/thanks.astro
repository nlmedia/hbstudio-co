---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you — HB Studio Co" description="Your message has been sent.">
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl grad-accent text-3xl text-white">✓</div>
    <h1 class="mt-6 font-display text-4xl font-bold">Message sent</h1>
    <p class="mt-3 text-muted">Thanks for reaching out — we'll get back to you within 1–2 business days.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-ink px-6 py-3 font-medium text-paper transition hover:bg-accent">Back to home</a>
  </section>
</Base>
