---
import { useTranslations, getLocaleFromPath, stripLocalePrefix, localizePath, getAlternatePath } from '../i18n';

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const t = useTranslations(locale);
const bare = stripLocalePrefix(path);

const links = [
  { href: '/templates', label: t.nav.templates },
  { href: '/category/shopify', label: t.nav.shopify },
  { href: '/category/wordpress', label: t.nav.wordpress },
  { href: '/category/woocommerce', label: t.nav.woocommerce },
  { href: '/about', label: t.nav.agency },
];

// The language switcher points at the equivalent page in the other
// locale (never the homepage), so a visitor reading a theme page stays
// on that same theme page when switching language.
const altHref = getAlternatePath(path);
const altLocale = locale === 'en' ? 'fr' : 'en';
const altLabel = altLocale === 'fr' ? 'Français' : 'English';
---
<header data-header class="sticky top-0 z-50 transition-all duration-300 [&.is-scrolled]:border-b [&.is-scrolled]:border-hair [&.is-scrolled]:bg-bg/80 [&.is-scrolled]:backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href={localizePath('/', locale)} class="group flex items-center gap-2.5" aria-label={t.nav.homeAriaLabel}>
      <!-- The mark is the one permanent vermilion on the site. Everything else
           in the header stays neutral so the mark keeps its meaning. -->
      <span class="grid h-8 w-8 place-items-center bg-signal font-display text-sm font-bold text-on-signal">HB</span>
      <span class="font-display text-[15px] font-semibold leading-none">HB Studio.Co</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm text-fg/65 md:flex">
      {links.map((l) => (
        <a
          href={localizePath(l.href, locale)}
          class:list={['link-underline transition hover:text-fg', { 'text-fg font-medium': bare.startsWith(l.href) && l.href !== '/' }]}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={altHref}
        hreflang={altLocale}
        data-lang-switch={altLocale}
        aria-label={`${t.nav.switchTo}${altLabel}`}
        class="hidden items-center gap-1.5 rounded-full border border-hair px-3 py-1.5 text-xs font-medium text-fg/60 transition hover:border-hair-strong hover:text-fg sm:inline-flex"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
        {altLocale.toUpperCase()}
      </a>
      <a href={localizePath('/templates', locale)} class="hidden rounded-full bg-fg px-4 py-2 text-sm font-medium text-bg transition active:scale-[0.98] sm:inline-block">{t.nav.getTemplate}</a>
      <details class="relative md:hidden">
        <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-[2px] border border-hair text-fg" aria-label={t.nav.menuAriaLabel}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-[2px] border border-hair bg-panel p-2">
          {links.map((l) => (<a href={localizePath(l.href, locale)} class="block rounded-[2px] px-3 py-2 text-sm text-fg/80 hover:bg-panel-2">{l.label}</a>))}
          <a href={altHref} hreflang={altLocale} data-lang-switch={altLocale} class="block rounded-[2px] px-3 py-2 text-sm text-fg/80 hover:bg-panel-2">{altLabel}</a>
          <a href={localizePath('/contact', locale)} class="mt-1 block rounded-full bg-fg px-3 py-2 text-center text-sm font-medium text-bg">{t.nav.getInTouch}</a>
        </div>
      </details>
    </div>
  </div>
</header>
