---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CMS } from '../../data/cms';

export async function getStaticPaths() {
  const all = await getCollection('templates');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const c = CMS[d.cms as keyof typeof CMS];
const soon = d.status === 'coming-soon';
const { Content } = await render(entry);
---
<Base title={`${d.title} — ${c.label} template | HB Studio Co`} description={d.tagline} image={d.cover ?? '/brand/og.jpg'}>
  <!-- HERO -->
  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2 lg:items-center">
      <div>
        <a href={`/category/${d.cms}`} class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium" style={`background:${c.accent}22;color:${c.accent}`}>
          <span class="h-2 w-2 rounded-full" style={`background:${c.accent}`}></span>{c.label}
        </a>
        <h1 class="mt-5 font-display text-5xl font-bold leading-tight">{d.title}</h1>
        <p class="mt-3 text-lg text-paper/70">{d.tagline}</p>
        <p class="mt-5 max-w-md text-paper/60">{d.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {soon ? (
            <a href="/contact" class="rounded-full bg-paper px-6 py-3 font-medium text-ink transition hover:bg-accent hover:text-white">Notify me at launch</a>
          ) : (
            <>
              <a href={d.buyUrl ?? '#'} class="rounded-full bg-paper px-6 py-3 font-medium text-ink transition hover:bg-accent hover:text-white">Buy — {d.currency}{d.price}</a>
              {d.demoUrl && <a href={d.demoUrl} target="_blank" rel="noopener" class="rounded-full border border-white/25 px-6 py-3 font-medium transition hover:bg-white/10">Live demo</a>}
            </>
          )}
        </div>
        {!soon && <p class="mt-3 text-sm text-paper/50">One-time payment · single store · lifetime updates</p>}
      </div>
      <div>
        {d.cover ? (
          <img src={d.cover} alt={d.title} class="w-full rounded-2xl border border-white/10 shadow-2xl" />
        ) : (
          <div class="flex aspect-[16/11] items-center justify-center rounded-2xl border border-white/10 bg-white/5">
            <span class="font-display text-4xl font-bold text-white/20">{d.title}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- FEATURES + BODY -->
  <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="prose-like text-lg leading-relaxed text-ink/80">
        <Content />
      </div>
      {d.features.length > 0 && (
        <>
          <h2 class="mt-10 font-display text-2xl font-bold">What's inside</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {d.features.map((f: string) => (
              <li class="flex gap-3 text-sm text-ink/80">
                <span class="mt-0.5 text-accent">✓</span>{f}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
    <aside class="lg:col-span-1">
      <div class="sticky top-24 rounded-2xl border border-line bg-white p-6">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-muted">Price</span>
          <span class="font-display text-2xl font-bold">{d.price != null ? `${d.currency}${d.price}` : '—'}</span>
        </div>
        <div class="mt-4 space-y-2 border-t border-line pt-4 text-sm text-ink/70">
          {d.tags.map((t: string) => <span class="mr-1.5 inline-block rounded-full bg-paper-dim px-2.5 py-1 text-xs">{t}</span>)}
        </div>
        {soon ? (
          <a href="/contact" class="mt-5 block rounded-full bg-ink px-6 py-3 text-center font-medium text-paper transition hover:bg-accent">Notify me</a>
        ) : (
          <a href={d.buyUrl ?? '#'} class="mt-5 block rounded-full bg-ink px-6 py-3 text-center font-medium text-paper transition hover:bg-accent">Buy {d.title}</a>
        )}
        {d.docsUrl && <a href={d.docsUrl} target="_blank" rel="noopener" class="mt-2 block text-center text-sm font-medium text-accent hover:underline">Read the documentation →</a>}
      </div>
    </aside>
  </section>

  <!-- GALLERY -->
  {d.gallery.length > 0 && (
    <section class="bg-paper-dim/60">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="font-display text-2xl font-bold">A closer look</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {d.gallery.map((src: string, i: number) => (
            <img src={src} alt={`${d.title} screenshot ${i + 1}`} loading="lazy" class:list={['w-full rounded-2xl border border-line bg-white shadow-sm', { 'sm:col-span-2': i === 0 }]} />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-12 text-center">
    <a href="/templates" class="text-sm font-medium text-accent hover:underline">← Back to all templates</a>
  </section>
</Base>
