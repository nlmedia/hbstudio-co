---
import Base from '../../layouts/Base.astro';
import DeviceMockup from '../../components/DeviceMockup.astro';
import Countdown from '../../components/Countdown.astro';
import { CMS } from '../../data/cms';
import { getTemplates } from '../../lib/catalog';

export async function getStaticPaths() {
  const all = await getTemplates();
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const c = CMS[d.cms as keyof typeof CMS];
const soon = d.status === 'coming-soon';
const bodyParagraphs = (d.body || '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<Base title={`${d.title} — ${c.label} template | HB Studio Co`} description={d.tagline} image={d.cover ?? '/brand/og.jpg'}>
  <!-- HERO -->
  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2 lg:items-center">
      <div>
        <a href={`/category/${d.cms}`} class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium" style={`background:${c.accent}22;color:${c.accent}`}>
          <span class="h-2 w-2 rounded-full" style={`background:${c.accent}`}></span>{c.label}
        </a>
        <h1 class="mt-5 font-display text-5xl font-bold leading-tight">{d.title}</h1>
        <p class="mt-3 text-lg text-paper/70">{d.tagline}</p>
        <p class="mt-5 max-w-md text-paper/60">{d.description}</p>
        {soon ? (
          <div class="mt-8">
            <a href="/contact" class="inline-block rounded-full bg-paper px-6 py-3 font-medium text-ink transition hover:bg-accent hover:text-white">Notify me at launch</a>
          </div>
        ) : (
          <div class="mt-8" data-promo-scope>
            {d.onSale && d.saleEndsAt && (
              <div data-when-promo class="mb-5">
                <Countdown deadline={d.saleEndsAt} dark />
              </div>
            )}
            <div class="flex flex-wrap items-center gap-4">
              <a href="#" data-checkout={entry.id} class="rounded-full bg-paper px-6 py-3 font-medium text-ink transition hover:bg-accent hover:text-white">
                {d.onSale ? (
                  <>
                    <span data-when-promo>Buy — <span class="text-ink/45 line-through">{d.currency}{d.price}</span> {d.currency}{d.salePrice}</span>
                    <span data-when-ended class="hidden">Buy — {d.currency}{d.price}</span>
                  </>
                ) : (
                  <>Buy — {d.currency}{d.price}</>
                )}
              </a>
              {d.demoUrl && <a href={d.demoUrl} target="_blank" rel="noopener" class="rounded-full border border-white/25 px-6 py-3 font-medium transition hover:bg-white/10">Live demo</a>}
            </div>
            <p class="mt-3 text-sm text-paper/50">One-time payment · single store · lifetime updates</p>
          </div>
        )}
      </div>
      <div>
        {d.preview ? (
          <DeviceMockup desktop={d.preview} mobile={d.previewMobile} url={`${d.title.toLowerCase()}.myshopify.com`} />
        ) : d.cover ? (
          <img src={d.cover} alt={d.title} class="w-full rounded-2xl border border-white/10 shadow-2xl" />
        ) : (
          <div class="flex aspect-[16/11] items-center justify-center rounded-2xl border border-white/10 bg-white/5">
            <span class="font-display text-4xl font-bold text-white/20">{d.title}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- FEATURES + BODY -->
  <section class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div class="space-y-4 text-lg leading-relaxed text-ink/75">
        {bodyParagraphs.map((p) => <p>{p}</p>)}
      </div>
      {d.features.length > 0 && (
        <>
          <h2 class="mt-10 font-display text-2xl font-bold">What's inside</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {d.features.map((f: string) => (
              <li class="flex gap-3 text-sm text-ink/80">
                <span class="mt-0.5 text-accent-2">✓</span>{f}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
    <aside class="lg:col-span-1">
      <div class="sticky top-24 rounded-2xl border border-line bg-surface p-6" data-promo-scope>
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-sm text-muted">Price</span>
          {d.price != null ? (
            d.onSale ? (
              <span class="text-right">
                <span data-when-promo class="flex items-baseline justify-end gap-2">
                  <span class="text-sm font-medium text-muted line-through">{d.currency}{d.price}</span>
                  <span class="font-display text-2xl font-bold text-[#e23b3b]">{d.currency}{d.salePrice}</span>
                  <span class="rounded-md bg-[#e23b3b] px-1.5 py-0.5 text-xs font-bold text-white">−{d.discountPct}%</span>
                </span>
                <span data-when-ended class="hidden font-display text-2xl font-bold">{d.currency}{d.price}</span>
              </span>
            ) : (
              <span class="font-display text-2xl font-bold">{d.currency}{d.price}</span>
            )
          ) : <span class="font-display text-2xl font-bold">—</span>}
        </div>
        {!soon && d.onSale && d.saleEndsAt && (
          <div data-when-promo class="mt-4 rounded-xl border border-[#e23b3b]/20 bg-[#e23b3b]/5 p-3">
            <Countdown deadline={d.saleEndsAt} compact />
          </div>
        )}
        <div class="mt-4 space-y-2 border-t border-line pt-4 text-sm text-ink/70">
          {d.tags.map((t: string) => <span class="mr-1.5 inline-block rounded-full bg-surface-2 px-2.5 py-1 text-xs">{t}</span>)}
        </div>
        {soon ? (
          <a href="/contact" class="mt-5 block rounded-full bg-ink px-6 py-3 text-center font-medium text-paper transition hover:bg-accent">Notify me</a>
        ) : (
          <a href="#" data-checkout={entry.id} class="mt-5 block rounded-full bg-ink px-6 py-3 text-center font-medium text-paper transition hover:bg-accent">Buy {d.title}</a>
        )}
        {d.docsUrl && <a href={d.docsUrl} target="_blank" rel="noopener" class="mt-2 block text-center text-sm font-medium text-accent-2 hover:underline">Read the documentation →</a>}
      </div>
    </aside>
  </section>

  <!-- INTERACTIVE DEMO (self-hosted) — falls back to a static gallery -->
  {d.demoUrl && d.demoUrl.startsWith('/demo/') ? (
    <section class="border-y border-line bg-surface/30">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p data-reveal class="text-sm font-medium uppercase tracking-[0.2em] text-accent">Interactive demo</p>
            <h2 data-reveal style="transition-delay:80ms" class="mt-2 font-display text-2xl font-bold sm:text-3xl">Explore {d.title} live</h2>
          </div>
          <a href={d.demoUrl} target="_blank" rel="noopener" class="hidden items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium transition hover:bg-surface-2 sm:inline-flex">
            Open in new tab
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </div>
        <div data-reveal-scale class="mt-6 overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_30px_70px_-30px_rgba(14,14,18,0.25)]">
          <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 truncate rounded-md bg-surface-2 px-3 py-1 text-xs text-muted">{d.title.toLowerCase()}.myshopify.com</span>
            <a href={d.demoUrl} target="_blank" rel="noopener" class="ml-auto text-xs font-medium text-accent sm:hidden">Open ↗</a>
          </div>
          <iframe src={d.demoUrl} title={`${d.title} live demo`} loading="lazy" class="h-[78vh] w-full bg-white"></iframe>
        </div>
        <p class="mt-3 text-center text-xs text-muted">Fully interactive — click through the storefront. (Cart &amp; checkout are disabled in the demo.)</p>
      </div>
    </section>
  ) : d.gallery.length > 0 ? (
    <section class="overflow-hidden border-y border-line bg-surface/30">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 data-reveal class="font-display text-2xl font-bold">A closer look</h2>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:items-start">
          <div class="flex flex-col gap-5">
            {d.gallery.filter((_: string, i: number) => i % 2 === 0).map((src: string, i: number) => (
              <img src={src} alt={`${d.title} screenshot ${i * 2 + 1}`} loading="lazy" data-reveal class="w-full rounded-2xl border border-line bg-surface shadow-sm" />
            ))}
          </div>
          <div data-gallery-parallax class="flex flex-col gap-5 sm:will-change-transform">
            {d.gallery.filter((_: string, i: number) => i % 2 === 1).map((src: string, i: number) => (
              <img src={src} alt={`${d.title} screenshot ${i * 2 + 2}`} loading="lazy" data-reveal class="w-full rounded-2xl border border-line bg-surface shadow-sm" />
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : null}

  <script>
    // Parallax on the right gallery column: starts offset downward, drifts up to
    // finish flush with the left column at the bottom. Desktop only, motion-safe.
    (function () {
      const col = document.querySelector('[data-gallery-parallax]') as HTMLElement | null;
      if (!col) return;
      const mqDesktop = window.matchMedia('(min-width: 640px)');
      const mqMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const OFFSET = 110; // px stagger between the two columns
      let raf = 0;

      const apply = () => {
        raf = 0;
        if (!mqDesktop.matches || mqMotion.matches) { col.style.transform = ''; return; }
        const section = col.closest('section');
        if (!section) return;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        // progress 0 → 1 as the section travels through the viewport
        const p = Math.min(1, Math.max(0, (vh - rect.top) / (rect.height + vh)));
        col.style.transform = `translate3d(0, ${((1 - p) * OFFSET).toFixed(1)}px, 0)`;
      };
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(apply); };

      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      mqDesktop.addEventListener('change', apply);
    })();
  </script>

  <section class="mx-auto max-w-6xl px-5 py-12 text-center">
    <a href="/templates" class="text-sm font-medium text-accent hover:underline">← Back to all templates</a>
  </section>
</Base>
