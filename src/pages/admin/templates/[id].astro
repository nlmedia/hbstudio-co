---
export const prerender = false;
import Admin from '../../../layouts/Admin.astro';
import TemplateForm from '../../../components/admin/TemplateForm.astro';
import { parseTemplateForm } from '../../../lib/templateForm';

const supabase = Astro.locals.supabase!;
const email = Astro.locals.user?.email ?? '';
const id = Astro.params.id!;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  if (action === 'delete') {
    await supabase.from('hb_templates').delete().eq('id', id);
    return Astro.redirect('/admin/templates?deleted=1');
  }
  if (action === 'publish' || action === 'unpublish') {
    await supabase.from('hb_templates').update({ status: action === 'publish' ? 'published' : 'draft' }).eq('id', id);
    return Astro.redirect('/admin/templates?saved=1');
  }
  const row = parseTemplateForm(form);
  if (!row.title || !row.slug) {
    error = 'Le titre et le slug sont requis.';
  } else {
    const { error: e } = await supabase.from('hb_templates').update(row).eq('id', id);
    if (e) error = e.message;
    else return Astro.redirect('/admin/templates?saved=1');
  }
}

const { data: t } = await supabase.from('hb_templates').select('*').eq('id', id).maybeSingle();
if (!t) return Astro.redirect('/admin/templates');
---
<Admin title={`Modifier — ${t.title}`} active="templates" email={email}>
  {error && <p class="mb-5 rounded-xl bg-[#fbeaea] px-4 py-3 text-sm text-[#b3261e]">{error}</p>}
  <div class="mb-5 flex items-center gap-3 text-sm">
    <a href={`/templates/${t.slug}`} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">Voir sur le site ↗</a>
    <form method="POST" action={`/admin/templates/${id}`} onsubmit="return confirm('Supprimer définitivement ce template ?')">
      <input type="hidden" name="_action" value="delete" />
      <button class="font-medium text-[#b3261e] hover:underline">Supprimer</button>
    </form>
  </div>
  <TemplateForm t={t} action={`/admin/templates/${id}`} submitLabel="Enregistrer les modifications" />
</Admin>
