---
import Base from '../../layouts/Base.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import { CMS, CMS_ORDER } from '../../data/cms';
import { getTemplates } from '../../lib/catalog';
import { useTranslations, getLocaleFromPath } from '../../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const all = await getTemplates(locale);
---
<Base title={t.templatesIndex.meta.title} description={t.templatesIndex.meta.description}>
  <section class="relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-20">
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-fg-muted">{t.templatesIndex.eyebrow}</p>
      <h1 data-reveal style="transition-delay:80ms" class="mt-5 font-display text-5xl font-medium sm:text-6xl">{t.templatesIndex.heading}</h1>
      <p data-reveal style="transition-delay:160ms" class="mt-5 max-w-xl leading-relaxed text-fg-muted">{t.templatesIndex.subtitle}</p>

      <nav data-reveal style="transition-delay:240ms" class="mt-9 flex flex-wrap gap-2">
        <a href="/templates" class="rounded-full bg-fg px-4 py-2 text-sm font-medium text-bg">{t.common.all}</a>
        {CMS_ORDER.map((k) => (
          <a href={`/category/${k}`} class="rounded-full border border-hair px-4 py-2 text-sm font-medium text-fg/65 transition hover:border-hair-strong hover:text-fg">{CMS[k].label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((entry) => <TemplateCard entry={entry} />)}
    </div>
  </section>
</Base>
