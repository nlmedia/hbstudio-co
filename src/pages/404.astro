---
import Base from '../layouts/Base.astro';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.notFound.meta.title}>
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <p class="font-display text-7xl font-bold text-signal">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold">{t.notFound.heading}</h1>
    <p class="mt-3 text-fg-muted">{t.notFound.body}</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="rounded-full bg-fg px-6 py-3 font-medium text-bg transition hover:bg-signal">{t.notFound.home}</a>
      <a href="/templates" class="rounded-full border border-hair-strong px-6 py-3 font-medium transition hover:bg-panel">{t.common.browseTemplates}</a>
    </div>
  </section>
</Base>
