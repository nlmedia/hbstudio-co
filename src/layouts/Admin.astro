---
import '../styles/global.css';
import { getAlerts } from '../lib/alerts';
interface Props { title?: string; active?: string; email?: string | null; }
const { title = 'Admin', active = 'dashboard', email = '' } = Astro.props;

const supabase = (Astro.locals as any).supabase;
const alerts = supabase ? await getAlerts(supabase).catch(() => []) : [];
const warnCount = alerts.filter((a) => a.level === 'warn').length;

const groups = [
  {
    label: 'Principal',
    items: [
      { key: 'dashboard', label: 'Tableau de bord', href: '/admin', icon: 'M4 13h6V4H4v9zm0 7h6v-5H4v5zm10 0h6V11h-6v9zm0-16v5h6V4h-6z' },
    ],
  },
  {
    label: 'Gestion',
    items: [
      { key: 'templates', label: 'Templates', href: '/admin/templates', icon: 'M4 5h16M4 12h16M4 19h10' },
      { key: 'sales', label: 'Ventes', href: '/admin/sales', icon: 'M3 3v18h18M7 14l3-3 3 3 5-5' },
      { key: 'licenses', label: 'Licences', href: '/admin/licenses', icon: 'M7 15a4 4 0 100-8 4 4 0 000 8zM9.5 12.5L20 3M20 3h-4M20 3v4' },
      { key: 'subscribers', label: 'Abonnés', href: '/admin/subscribers', icon: 'M16 14a4 4 0 10-8 0M12 7a3 3 0 100-6 3 3 0 000 6zM4 21v-1a4 4 0 014-4h8a4 4 0 014 4v1' },
      { key: 'campaigns', label: 'Campagnes', href: '/admin/campaigns', icon: 'M4 6h16v12H4zM4 7l8 6 8-6' },
    ],
  },
  {
    label: 'Configuration',
    items: [
      { key: 'settings', label: 'Réglages', href: '/admin/settings', icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19 12a7 7 0 00-.1-1l2-1.6-2-3.4-2.4 1a7 7 0 00-1.7-1L14.5 2h-5l-.3 2.9a7 7 0 00-1.7 1l-2.4-1-2 3.4L3 11a7 7 0 000 2l-2 1.6 2 3.4 2.4-1a7 7 0 001.7 1l.3 2.9h5l.3-2.9a7 7 0 001.7-1l2.4 1 2-3.4-2-1.6a7 7 0 00.1-1z' },
    ],
  },
];
const initials = (email || 'HB').slice(0, 2).toUpperCase();
---
<!doctype html>
<html lang="fr" class="bg-surface-2">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — HB Studio Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-surface-2 text-ink antialiased">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="fixed inset-y-0 left-0 hidden w-64 shrink-0 flex-col border-r border-line bg-surface md:flex">
        <a href="/admin" class="flex h-16 items-center gap-2.5 border-b border-line px-5">
          <span class="grid h-8 w-8 place-items-center rounded-lg grad-accent font-display text-sm font-bold text-white">HB</span>
          <span class="font-display text-[15px] font-bold">Studio<span class="text-accent">.</span>Admin</span>
        </a>
        <nav class="flex flex-1 flex-col gap-6 overflow-y-auto px-3 py-5">
          {groups.map((g) => (
            <div>
              <p class="px-3 pb-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-muted/70">{g.label}</p>
              <div class="flex flex-col gap-0.5">
                {g.items.map((n) => (
                  <a href={n.href} class:list={['group relative flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm transition', active === n.key ? 'bg-accent-soft font-medium text-accent' : 'text-ink/70 hover:bg-surface-2 hover:text-ink']}>
                    {active === n.key && <span class="absolute inset-y-1.5 left-0 w-0.5 rounded-full bg-accent"></span>}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={n.icon} /></svg>
                    {n.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
        <a href="/" class="m-3 flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-muted transition hover:bg-surface-2 hover:text-ink">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg> Voir le site
        </a>
      </aside>

      <!-- Main -->
      <div class="flex min-w-0 flex-1 flex-col md:pl-64">
        <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-line bg-surface/85 px-4 backdrop-blur sm:px-6">
          <h1 class="font-display text-lg font-bold md:hidden">HB Admin</h1>
          <!-- Global search -->
          <form action="/admin/templates" method="GET" class="relative hidden flex-1 sm:block" role="search">
            <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input name="q" type="search" placeholder="Rechercher un template…" class="w-full max-w-md rounded-full border border-line bg-surface-2/60 py-2 pl-9 pr-4 text-sm outline-none transition focus:border-accent focus:bg-surface" />
          </form>
          <div class="flex flex-1 items-center justify-end gap-1.5 sm:flex-none">
            <!-- Notifications -->
            <details class="group relative">
              <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-full text-ink/70 transition hover:bg-surface-2 [&::-webkit-details-marker]:hidden">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0"/></svg>
                {warnCount > 0 && <span class="absolute right-1 top-1 grid h-4 min-w-4 place-items-center rounded-full bg-[#e23b3b] px-1 text-[10px] font-bold text-white">{warnCount}</span>}
              </summary>
              <div class="absolute right-0 mt-2 w-80 overflow-hidden rounded-xl border border-line bg-surface shadow-[0_20px_50px_-20px_rgba(14,14,18,0.3)]">
                <div class="flex items-center justify-between border-b border-line px-4 py-3">
                  <span class="text-sm font-semibold">Notifications</span>
                  <span class="rounded-full bg-surface-2 px-2 py-0.5 text-xs text-muted">{alerts.length}</span>
                </div>
                <div class="max-h-80 overflow-y-auto">
                  {alerts.length > 0 ? alerts.map((a) => (
                    <a href={a.href} class="flex items-start gap-2.5 border-b border-line px-4 py-3 text-sm transition last:border-0 hover:bg-surface-2">
                      <span class:list={['mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full text-[11px] font-bold', a.level === 'warn' ? 'bg-[#fbeaea] text-[#b3261e]' : 'bg-accent-soft text-accent']}>{a.level === 'warn' ? '!' : 'i'}</span>
                      <span class="text-ink/80">{a.text}</span>
                    </a>
                  )) : <p class="px-4 py-6 text-center text-sm text-muted">✓ Rien à signaler.</p>}
                </div>
              </div>
            </details>
            <!-- User menu -->
            <details class="group relative">
              <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full py-1 pl-1 pr-2 transition hover:bg-surface-2 [&::-webkit-details-marker]:hidden">
                <span class="grid h-8 w-8 place-items-center rounded-full grad-accent text-xs font-bold text-white">{initials}</span>
                <span class="hidden text-sm font-medium sm:inline">{email}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-xl border border-line bg-surface shadow-[0_20px_50px_-20px_rgba(14,14,18,0.3)]">
                <div class="border-b border-line px-4 py-3">
                  <p class="text-xs text-muted">Connecté en tant que</p>
                  <p class="truncate text-sm font-medium">{email}</p>
                </div>
                <a href="/admin/settings" class="flex items-center gap-2.5 px-4 py-2.5 text-sm transition hover:bg-surface-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-2.7 1.1V21a2 2 0 11-4 0v-.1A1.6 1.6 0 005 19.4l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.6 1.6 0 00-1.1-2.7H1a2 2 0 110-4h.1A1.6 1.6 0 002.6 5l-.1-.1a2 2 0 112.8-2.8l.1.1a1.6 1.6 0 001.8.3H7a1.6 1.6 0 001-1.5V1a2 2 0 114 0v.1a1.6 1.6 0 002.7 1.1l.1-.1a2 2 0 112.8 2.8l-.1.1a1.6 1.6 0 00-.3 1.8V7a1.6 1.6 0 001.5 1H21a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"/></svg> Réglages</a>
                <a href="/" class="flex items-center gap-2.5 px-4 py-2.5 text-sm transition hover:bg-surface-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg> Voir le site</a>
                <a href="/admin/auth/signout" class="flex items-center gap-2.5 border-t border-line px-4 py-2.5 text-sm font-medium text-[#b3261e] transition hover:bg-[#fbeaea]"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg> Déconnexion</a>
              </div>
            </details>
          </div>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">
          <div class="mb-6 hidden md:block">
            <h1 class="font-display text-2xl font-bold">{title}</h1>
          </div>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
