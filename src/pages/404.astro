---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — HB Studio Co">
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <p class="font-display text-7xl font-bold text-grad">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold">This page took a day off</h1>
    <p class="mt-3 text-muted">The page you're looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="rounded-full bg-ink px-6 py-3 font-medium text-paper transition hover:bg-accent">Home</a>
      <a href="/templates" class="rounded-full border border-line px-6 py-3 font-medium transition hover:border-ink">Browse templates</a>
    </div>
  </section>
</Base>
