---
const links = [
  { href: '/templates', label: 'Templates' },
  { href: '/category/shopify', label: 'Shopify' },
  { href: '/category/wordpress', label: 'WordPress' },
  { href: '/category/woocommerce', label: 'WooCommerce' },
  { href: '/about', label: 'Agency' },
];
const path = Astro.url.pathname;
---
<header data-header class="sticky top-0 z-50 transition-all duration-300 [&.is-scrolled]:border-b [&.is-scrolled]:border-line [&.is-scrolled]:bg-ink/70 [&.is-scrolled]:backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="group flex items-center gap-2.5" aria-label="HB Studio Co — home">
      <span class="grid h-8 w-8 place-items-center rounded-lg grad-accent font-display text-sm font-bold text-white transition group-hover:rotate-6">HB</span>
      <span class="font-display text-[15px] font-bold leading-none">HB Studio<span class="text-accent">.</span>Co</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm text-paper/65 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['link-underline transition hover:text-paper', { 'text-paper font-medium': path.startsWith(l.href) && l.href !== '/' }]}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="hidden rounded-full bg-paper px-4 py-2 text-sm font-medium text-ink transition hover:bg-accent hover:text-white sm:inline-block">Get in touch</a>
      <details class="relative md:hidden">
        <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border border-line text-paper" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-xl border border-line bg-surface p-2 shadow-2xl">
          {links.map((l) => (<a href={l.href} class="block rounded-lg px-3 py-2 text-sm text-paper/80 hover:bg-surface-2">{l.label}</a>))}
          <a href="/contact" class="mt-1 block rounded-lg bg-accent px-3 py-2 text-sm font-medium text-white">Get in touch</a>
        </div>
      </details>
    </div>
  </div>
</header>
