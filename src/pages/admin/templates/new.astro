---
export const prerender = false;
import Admin from '../../../layouts/Admin.astro';
import TemplateForm from '../../../components/admin/TemplateForm.astro';
import { parseTemplateForm } from '../../../lib/templateForm';

const supabase = Astro.locals.supabase!;
const email = Astro.locals.user?.email ?? '';
let error = '';

if (Astro.request.method === 'POST') {
  const row = parseTemplateForm(await Astro.request.formData());
  if (!row.title || !row.slug) {
    error = 'Le titre et le slug sont requis.';
  } else {
    const { data: inserted, error: e } = await supabase.from('hb_templates').insert(row).select();
    if (e) error = e.message;
    else if (!inserted || inserted.length === 0) error = "Création impossible — droits insuffisants (connexion admin requise).";
    else return Astro.redirect('/admin/templates?created=1');
  }
}
---
<Admin title="Nouveau template" active="templates" email={email}>
  {error && <p class="mb-5 rounded-xl bg-[#fbeaea] px-4 py-3 text-sm text-[#b3261e]">{error}</p>}
  <TemplateForm action="/admin/templates/new" submitLabel="Créer le template" />
</Admin>
