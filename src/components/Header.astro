---
const links = [
  { href: '/templates', label: 'Templates' },
  { href: '/category/shopify', label: 'Shopify' },
  { href: '/category/wordpress', label: 'WordPress' },
  { href: '/category/woocommerce', label: 'WooCommerce' },
  { href: '/about', label: 'Agency' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="group flex items-center gap-2.5" aria-label="HB Studio Co — home">
      <span class="grid h-8 w-8 place-items-center rounded-lg grad-accent font-display text-sm font-bold text-white">HB</span>
      <span class="font-display text-[15px] font-bold leading-none">HB Studio<span class="text-accent">.</span>Co</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm text-ink/70 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['transition hover:text-ink', { 'text-ink font-medium': path.startsWith(l.href) && l.href !== '/' }]}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="hidden rounded-full border border-ink px-4 py-2 text-sm font-medium transition hover:bg-ink hover:text-paper sm:inline-block">Get in touch</a>
      <details class="relative md:hidden">
        <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-lg border border-line" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-52 rounded-xl border border-line bg-paper p-2 shadow-xl">
          {links.map((l) => (<a href={l.href} class="block rounded-lg px-3 py-2 text-sm hover:bg-paper-dim">{l.label}</a>))}
          <a href="/contact" class="mt-1 block rounded-lg bg-ink px-3 py-2 text-sm font-medium text-paper">Get in touch</a>
        </div>
      </details>
    </div>
  </div>
</header>
