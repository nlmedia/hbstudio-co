---
import Base from '../layouts/Base.astro';
import { useTranslations, getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---
<Base title={t.thanks.meta.title} description={t.thanks.meta.description}>
  <section class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="mx-auto grid h-16 w-16 place-items-center rounded-[2px] bg-signal text-3xl text-on-signal">✓</div>
    <h1 class="mt-6 font-display text-4xl font-semibold">{t.thanks.heading}</h1>
    <p class="mt-3 text-fg-muted">{t.thanks.body}</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-fg px-6 py-3 font-medium text-bg transition active:scale-[0.98]">{t.thanks.backHome}</a>
  </section>
</Base>
